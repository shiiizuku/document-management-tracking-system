# Compile MinIO from the AGPL source tree (no license gate, no prebuilt binary download).
FROM golang:1.27-alpine AS build
RUN apk add --no-cache git bash
WORKDIR /src
COPY . .
ENV CGO_ENABLED=0 GOFLAGS=-mod=mod
RUN go build -trimpath -o /minio . && (/minio --version || true)

FROM alpine:3.22
RUN apk add --no-cache ca-certificates curl && mkdir -p /data
COPY --from=build /minio /usr/bin/minio
EXPOSE 9000 9001
ENTRYPOINT ["minio"]
CMD ["server", "/data", "--console-address", ":9001"]
