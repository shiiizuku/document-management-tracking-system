NODE_ENV=development
PORT=4001
WEB_ORIGIN=http://localhost:3001
LOG_LEVEL=info
DATABASE_URL=postgresql://dts:dts@localhost:5433/dts
REDIS_URL=redis://localhost:6380
MINIO_ENDPOINT=http://localhost:9002
MINIO_ACCESS_KEY=dts-local
MINIO_SECRET_KEY=change-this-local-secret
MINIO_BUCKET=dts-files
CLAMAV_HOST=localhost
CLAMAV_PORT=3311
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE_MS=1800000
# The upload ceiling the API enforces. It may only *narrow* the 25 MiB compiled into the multipart
# parser (`MAX_ATTACHMENT_BYTES`), which is a decorator argument and cannot be raised from here; a
# larger value is refused at boot rather than silently capped.
UPLOAD_MAX_BYTES=26214400
WORKER_HEALTH_PORT=4002

# Where continuous backups land. MUST be a mount on a different machine in production:
# an archive on the application host is lost with the host. Relative paths are for local work.
BACKUP_PATH=./backups

# Read by docker-compose.yml when the whole stack runs in containers (README, Production stack).
# The public API base the browser calls; compiled into the web bundle, so rebuild `web` after
# changing it. Defaults to http://localhost:${API_HOST_PORT}/api/v1.
# PUBLIC_API_URL=https://dts.example.gov.ph/api/v1
# POSTGRES_PASSWORD=
# SEED_ADMIN_PASSWORD=
