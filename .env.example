NODE_ENV=development
PORT=4001
WEB_ORIGIN=http://localhost:3001
LOG_LEVEL=info
DATABASE_URL=postgresql://dts:dts@localhost:5433/dts
# Connections per process (API and worker each). Match the database host's cores: Postgres is the
# CPU-bound side under load, so a bigger pool only moves the queue into Postgres. A request that
# waits 5 s for a connection, or runs a statement past the timeout, is answered 503 with
# Retry-After instead of a 500. The timeout applies to the API only.
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
REDIS_URL=redis://localhost:6380
MINIO_ENDPOINT=http://localhost:9002
MINIO_ACCESS_KEY=dts-local
MINIO_SECRET_KEY=change-this-local-secret
MINIO_BUCKET=dts-files
CLAMAV_HOST=localhost
CLAMAV_PORT=3311
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_MAX_AGE_MS=1800000
# The upload ceiling the API enforces. It may only *narrow* the 25 MiB compiled into the multipart
# parser (`MAX_ATTACHMENT_BYTES`), which is a decorator argument and cannot be raised from here; a
# larger value is refused at boot rather than silently capped.
UPLOAD_MAX_BYTES=26214400
WORKER_HEALTH_PORT=4002
# Which hops in front of the API may report the client address through X-Forwarded-For. The
# rate limiter and the source IP recorded on login audit events both come from it. Leave
# unset (or false) for local work, where the header is ignored. Behind the pilot's TLS ingress set
# the hop count (1 for a single ingress) or the ingress addresses/CIDRs (comma-separated; also
# loopback, linklocal, uniquelocal); otherwise the whole office shares one rate-limit bucket and
# one 5/min login window. `true` is refused at boot: it would trust whatever the client sends.
# TRUST_PROXY=1

# The Regional Director's account, as deployment configuration rather than seed data (ADR-0006).
# Release is gated on a signature record and nobody but a DIRECTOR may make one, so a deployment
# without this account registers and routes correspondence perfectly and then stalls at
# FOR_SIGNATURE. With NODE_ENV=production the API refuses to boot — and `db:seed` refuses to run —
# unless both are set; left unset for local work, the seed plants director@dts.local with the
# shared development password instead. The password is held to the same strength rule as every
# other password in the system.
# DIRECTOR_EMAIL=director@mgb.example.gov.ph
# DIRECTOR_PASSWORD=

# Where continuous backups land. MUST be a mount on a different machine in production:
# an archive on the application host is lost with the host. Relative paths are for local work.
BACKUP_PATH=./backups

# Read by docker-compose.yml when the whole stack runs in containers (README, Production stack).
# The public API base the browser calls; compiled into the web bundle, so rebuild `web` after
# changing it. Defaults to http://localhost:${API_HOST_PORT}/api/v1.
# PUBLIC_API_URL=https://dts.example.gov.ph/api/v1
# POSTGRES_PASSWORD=
# SEED_ADMIN_PASSWORD=

# The separate database audit events move to once they are five years old (policy P-08). Only
# `npm run audit:relocate -w @dts/api` reads it; IT operations names the real host. Leave unset
# until then — nothing relocates without it, and for five years nothing needs to.
# AUDIT_ARCHIVE_DATABASE_URL=postgresql://dts:dts@localhost:5433/dts_audit_archive
